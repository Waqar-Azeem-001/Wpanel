# Infrastructure only. Provider credentials (registrar, WHM, payment, email provider)
# are configured live in the admin portal and must never be added here.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
SITE_NAME=Wpanel
SITE_URL=http://localhost
DATABASE_URL=postgres://wpanel:wpanel@db:5432/wpanel
REDIS_URL=redis://redis:6379/0
DEFAULT_FROM_EMAIL=Wpanel <no-reply@example.com>
LOG_LEVEL=INFO
# Keep True behind HTTPS. Set False only for a local HTTP-only Docker run.
DJANGO_SECURE_SSL_REDIRECT=True
# Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=wpanel
# Fernet key for provider credentials stored in the DB. Generate once and never change:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Read automatically by Django's own `createsuperuser --noinput` (built into Django,
# no project code needed). Used once to create the first Super Admin login - for the
# Wpanel portal and the Django admin, which are the same account. Not read at runtime;
# safe to remove after the first superuser exists.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# All catalog prices and orders are in this one currency.
STORE_CURRENCY=USD
# Test payment gateway (simulated checkout, no real money). Never enable in production.
ALLOW_TEST_PAYMENT_GATEWAY=false

# Fulfil paid orders automatically in the background (leave on outside tests).
ORDER_AUTO_FULFIL=true
# Ticket attachments (private: never served by nginx). Defaults to ./private_media.
# PRIVATE_MEDIA_ROOT=/app/private_media
