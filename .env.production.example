# Production environment template. Copy to .env on the server and fill in. Never commit the filled-in file.
# Provider credentials (registrar, WHM, email provider, payment) are NOT set here: configure them in the admin.

DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=portal.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.com
SITE_NAME=WHpanel
SITE_URL=https://portal.example.com          # https, no trailing slash: every emailed link uses it
DJANGO_SECURE_SSL_REDIRECT=True

POSTGRES_PASSWORD=                            # long and random; must match DATABASE_URL
DATABASE_URL=postgres://whpanel:CHANGE_ME@db:5432/whpanel
REDIS_URL=redis://redis:6379/0
CREDENTIALS_ENCRYPTION_KEY=                   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
                                              # Generate ONCE, back it up separately, never change it (provider credentials depend on it)

DEFAULT_FROM_EMAIL=WHpanel <no-reply@portal.example.com>
STORE_CURRENCY=USD
ALLOW_TEST_PAYMENT_GATEWAY=false
ORDER_AUTO_FULFIL=true
EMAIL_OPEN_TRACKING=True
LOG_LEVEL=INFO
MAINTENANCE_FLAG_PATH=/app/maintenance/maintenance.flag

# Error tracking (recommended)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Turn on only after the WHM adapter is verified against the real server
HOSTING_USAGE_SYNC_ENABLED=false

# First Super Admin, read once by `createsuperuser --noinput`; remove after it exists
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
