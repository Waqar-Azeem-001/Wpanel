# HTTPS variant of whpanel.conf, for the "Nginx container holds the certificate" route (Let's Encrypt via Certbot).
# NOT used until the owner chooses this route. If TLS is terminated by a load balancer or a host-level Nginx instead,
# keep whpanel.conf as it is (Django already trusts X-Forwarded-Proto).
#
# Use: replace example.com, mount this file as /etc/nginx/conf.d/default.conf in the nginx service, publish port 443,
# and mount /etc/letsencrypt (certificates) and /var/www/certbot (the challenge folder) into the container.
# First certificate:  certbot certonly --webroot -w /var/www/certbot -d example.com   (run while the :80 block is up)
# Renewal is automatic with a cron/systemd timer running `certbot renew` and `nginx -s reload`.

upstream whpanel_web {
    server web:8000;
}

server {
    listen 80;
    server_name example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 20m;

    location /static/ {
        alias /app/staticfiles/;
        expires 7d;
    }

    location /media/ {
        alias /app/media/;
    }

    location = /maintenance.html {
        root /etc/nginx;
        internal;
    }

    location / {
        if (-f /srv/maintenance/maintenance.flag) {
            return 503;
        }
        error_page 503 /maintenance.html;

        proxy_pass http://whpanel_web;
        proxy_set_header Host $host;
        # Overwrite (not append) so clients cannot spoof their IP in audit logs.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 90s;
    }
}
