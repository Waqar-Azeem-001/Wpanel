# /etc/whpanel/deploy.env  (owned by root, mode 600; read by whpanel-deploy)
#
# The fingerprint (or e-mail) of YOUR public GPG key. The deploy script encrypts every pre-deploy database dump to it before the dump leaves this server.
# This server only ever holds the PUBLIC half, so it cannot open what it uploads. Import the public key once:  gpg --import your-public-key.asc
WHPANEL_GPG_RECIPIENT=
