# Copy to .env on the webmail host. Never commit the real file.
# The hosting (cPanel) server's mail host name, the one with a valid TLS certificate (IMAP 993 and SMTP 465 must be reachable from this host).
MAIL_SERVER_HOST=mail.example.com
# 24+ random characters, e.g.: openssl rand -hex 16
ROUNDCUBE_DES_KEY=
WEBMAIL_PRODUCT_NAME=Webmail
